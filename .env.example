# Copier ce fichier en .env et remplir les valeurs

# === BACKEND ===

# Port du serveur (Railway le fournit automatiquement)
PORT=3001

# URL de connexion PostgreSQL
# Railway la fournit automatiquement via la variable DATABASE_URL
# Format : postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://localhost:5432/agri_dashboard

# Origine autorisée pour CORS — mettre l'URL publique du service frontend
# Exemple : CORS_ORIGIN=https://frontend-production-xxx.up.railway.app
CORS_ORIGIN=*

# === FRONTEND ===

# URL publique du service backend Railway (sans slash final)
# Exemple : VITE_API_URL=https://backend-production-xxx.up.railway.app
VITE_API_URL=
