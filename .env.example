# Copier ce fichier en .env et remplir les valeurs

# Port du serveur (Railway le fournit automatiquement)
PORT=3001

# URL de connexion PostgreSQL
# Railway la fournit automatiquement via la variable DATABASE_URL
# Format : postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://localhost:5432/agri_dashboard

# Origine autorisée pour CORS (laisser * pour tout autoriser)
# Exemple : CORS_ORIGIN=https://monapp.up.railway.app
CORS_ORIGIN=*
