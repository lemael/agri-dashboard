# ─── Local development (SQLite) ──────────────────────────────────────────────
# Leave DATABASE_URL unset (or comment it out) to use local SQLite (local.db).
# The database file is created automatically on first start.

# PORT=3001
# CORS_ORIGIN=http://localhost:5173

# ─── Production (Railway / PostgreSQL) ───────────────────────────────────────
# Set DATABASE_URL to switch to PostgreSQL. Railway injects this automatically.
# DATABASE_URL=postgresql://postgres:password@zephyr.proxy.rlwy.net:17933/railway
